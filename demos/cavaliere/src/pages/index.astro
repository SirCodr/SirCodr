---
import Layout from '../layouts/Layout.astro'
import Brand from '../components/Brand.astro'
import Icon from '../components/Icon.astro'
import BarberPole from '../components/BarberPole.astro'
import Booking from '../components/Booking.astro'
import Reviews from '../components/Reviews.astro'
import Location from '../components/Location.astro'
import Services from '../components/Services.astro'
import PortfolioPromo from '../components/PortfolioPromo.astro'

---
<Layout>
  <header class="site-header" id="inicio">
    <Brand />
    <nav class="desktop-nav" aria-label="Navegación principal"><a href="#servicios">Servicios</a><a href="#resenas">Reseñas</a><a href="#ubicacion">Ubicación</a></nav>
    <div class="header-actions"><a class="header-booking" href="#reservar">Reserva tu cita <Icon name="arrow" /></a><button id="menu-toggle" class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Abrir menú"><Icon name="menu" /><Icon name="close" /></button></div>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Navegación móvil" hidden><a href="#servicios">Servicios <Icon name="arrow" /></a><a href="#resenas">Reseñas <Icon name="arrow" /></a><a href="#ubicacion">Ubicación <Icon name="arrow" /></a><a href="#reservar">Reserva tu cita <Icon name="arrow" /></a></nav>
  </header>

  <main id="contenido">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-image"><img src="/images/barbershop.webp" width="1800" height="1200" alt="El detalle de un ritual de barba con tijeras, fotografía de referencia" fetchpriority="high" /><div class="hero-image-shade"></div></div>
      <div class="hero-copy">
        <h1 id="hero-title"><span>Tu estilo</span><span>habla antes</span><span><em>que tú.</em></span></h1>
        <p class="hero-description">Corte de cabello, diseño de barba, asesoría y todo un ritual para encontrar un estilo que se sienta tuyo.</p>
        <div class="hero-cta"><a href="#reservar" class="button button--gold">Reserva tu experiencia <Icon name="arrow" /></a></div>
      </div>
      <img class="hero-gentleman" src="/images/cavaliere-gentleman.webp" width="1024" height="1536" alt="Ilustración de un caballero con traje oscuro y bigote" fetchpriority="high" />
      <BarberPole />
      <div class="hero-side-note" aria-hidden="true">AUTENTICIDAD. CERTEZA. COMPROMISO.</div>
      <div class="hero-bottom"><a href="#servicios" class="scroll-invite"><span class="scroll-circle"><Icon name="down" /></span> DESCUBRE EL RITUAL</a><span class="hero-location"><Icon name="pin" /> MEDELLÍN, COLOMBIA</span><span class="hero-edition">CAVALIERE · LAURELES</span></div>
    </section>

    <Services />
    <Reviews />
    <Location />
    <Booking />
  </main>

  <footer class="site-footer"><div class="footer-main"><Brand footer /><p>Autenticidad en el estilo.<br />Compromiso en cada detalle.</p><a href="#inicio" class="back-top" aria-label="Volver al inicio"><Icon name="down" /></a></div><div class="footer-bottom"><div class="footer-credit"><span class="footer-credit-kicker"><span aria-hidden="true"></span> DISEÑO WEB · JOTADEV</span><span class="footer-credit-name">Juan Restrepo</span><p class="footer-demo-note">Concepto de diseño para Cavaliere · Demo, no sitio oficial.</p></div><a class="footer-credit-cta" href="https://jotarestrepo.com" target="_blank" rel="noopener noreferrer">Conoce mi trabajo <span class="footer-credit-arrow" aria-hidden="true">↗</span></a></div></footer>
  <PortfolioPromo />
</Layout>
