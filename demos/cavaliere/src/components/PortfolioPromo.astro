---
const whatsappMessage = encodeURIComponent('Hola Juan, vi la demo de Barbería Cavaliere y quiero una web para mi negocio.')
const whatsappUrl = `https://wa.me/573105365457?text=${whatsappMessage}`
const portfolioUrl = 'https://jotarestrepo.com'
---
<aside class="portfolio-promo" aria-label="Diseño web por Juan Restrepo">
  <a class="promo-owner" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Contactar a JotaDev por WhatsApp" title="Contactar por WhatsApp">
    <span class="promo-whatsapp" aria-hidden="true">
      <svg viewBox="0 0 32 32" fill="none"><path d="M16 4.25A11.56 11.56 0 0 0 6.1 21.77L4.5 27.5l5.9-1.55A11.75 11.75 0 1 0 16 4.25Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12.1 10.3c-.35-.78-.72-.8-1.05-.81h-.9c-.31 0-.82.12-1.25.59-.43.47-1.64 1.6-1.64 3.91 0 2.3 1.67 4.53 1.9 4.84.23.31 3.23 5.17 7.97 7.04 3.95 1.55 4.75 1.24 5.61 1.16.86-.08 2.77-1.13 3.16-2.22.39-1.1.39-2.04.27-2.24-.12-.19-.43-.31-.9-.55-.47-.23-2.77-1.37-3.2-1.52-.43-.16-.74-.23-1.05.23-.31.47-1.21 1.52-1.48 1.83-.27.31-.55.35-1.02.12-.47-.23-1.98-.73-3.78-2.34-1.4-1.25-2.35-2.8-2.62-3.27-.27-.47-.03-.72.2-.95.21-.21.47-.55.7-.82.24-.27.31-.47.47-.78.16-.31.08-.59-.04-.82-.12-.23-1.02-2.54-1.4-3.47Z" fill="currentColor" transform="translate(5 1) scale(.68)"/></svg>
    </span>
    <span class="promo-copy"><span>¿Eres el dueño?</span><strong>Quiero esta web</strong></span>
  </a>

  <a class="promo-credit" href={portfolioUrl} target="_blank" rel="noopener noreferrer" aria-label="Ver el trabajo de Juan Restrepo" title="Ver el trabajo de Juan Restrepo">
    <span class="promo-monogram" aria-hidden="true">JR</span>
    <span class="promo-copy"><span>Web hecha por</span><strong>Juan Restrepo</strong></span>
    <span class="promo-arrow" aria-hidden="true">↗</span>
  </a>
</aside>
