---
import type { Locale } from '@/i18n/utils'

interface Props { locale: Locale; name?: boolean; href?: string }
const { locale, name = false, href = '#inicio' } = Astro.props
---
<a class="logo-link" href={href} aria-label={locale === 'es' ? 'JR, inicio' : 'JR, home'}>
  <img class="jr-mark" src="/portfolio/jr.svg" alt="" width="64" height="34" aria-hidden="true" />
  {name && <span>JUAN PABLO<br />RESTREPO</span>}
</a>
